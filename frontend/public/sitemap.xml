<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static sitemap for public pages.
  Dynamic product pages (/product/:id) should be served via a backend
  sitemap endpoint (e.g. GET /sitemap-products.xml) that generates entries
  for all published assets with their lastmod dates.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <url>
    <loc>https://gamesmith.io/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>

  <url>
    <loc>https://gamesmith.io/browse-all</loc>
    <changefreq>hourly</changefreq>
    <priority>0.9</priority>
  </url>

  <url>
    <loc>https://gamesmith.io/categories</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>

</urlset>
