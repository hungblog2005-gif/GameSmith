# Copy this file to .env and fill in the values before running docker compose.
# cp .env.example .env

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_USERNAME=gamesmith
MONGO_PASSWORD=changeme_in_production

# Local dev: MongoDB WITH auth (Docker-based local)
MONGODB_URI=mongodb://gamesmith:changeme_in_production@localhost:27017/gamesmith_db?authSource=admin
# Local dev: MongoDB without auth (default fresh install) — uncomment if not using Docker MongoDB:
# MONGODB_URI=mongodb://localhost:27017/gamesmith_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_64_byte_random_hex_string
JWT_EXPIRES_IN=15m

# ─── Payment ──────────────────────────────────────────────────────────────────
PAYMENT_GATEWAY_SECRET=replace_with_secret_from_payment_provider

# ─── Frontend (build-time) ────────────────────────────────────────────────────
# URL that the BROWSER uses to reach the API.
# In Docker, this is typically http://localhost:3000 for local dev
# or your public domain for production (e.g. https://api.yourdomain.com).
VITE_API_URL=http://localhost:3000

# ─── Ports ────────────────────────────────────────────────────────────────────
FRONTEND_PORT=80

# ─── CD / Docker Hub (production only) ───────────────────────────────────────
# Set by the CD pipeline automatically. Override here for manual deploys.
DOCKERHUB_USERNAME=your_dockerhub_username
IMAGE_TAG=latest
