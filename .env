# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_USERNAME=gamesmith
MONGO_PASSWORD=changeme_in_production

# NOTE: When running via docker compose, MONGODB_URI is overridden in
# docker-compose.yml to use the internal service name "mongodb".
# This value is used only when running the backend locally outside Docker.
MONGODB_URI=mongodb://gamesmith:changeme_in_production@localhost:27017/gamesmith_db?authSource=admin

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_64_byte_random_hex_string
JWT_EXPIRES_IN=15m

# ─── Payment ──────────────────────────────────────────────────────────────────
PAYMENT_GATEWAY_SECRET=replace_with_secret_from_payment_provider

# ─── VPS / Production ─────────────────────────────────────────────────────────
# Set VITE_API_URL to your VPS public IP or domain.
# All browser requests go to nginx (port 80) which proxies to backend internally.
# Example: VITE_API_URL=http://123.45.67.89  or  VITE_API_URL=https://yourdomain.com
VITE_API_URL=http://180.93.2.8
CORS_ORIGIN=http://180.93.2.8

# Set to false when running on HTTP (no HTTPS). Change to true when HTTPS is configured.
COOKIE_SECURE=false

# ─── Ports ────────────────────────────────────────────────────────────────────
FRONTEND_PORT=80

# ─── CD / Docker Hub (production only) ───────────────────────────────────────
# Set by the CD pipeline automatically. Override here for manual deploys.
DOCKERHUB_USERNAME=your_dockerhub_username
IMAGE_TAG=latest
